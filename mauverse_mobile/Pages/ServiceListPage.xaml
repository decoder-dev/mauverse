<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:mau.ViewModel.Services"
             xmlns:fonts="clr-namespace:mau.Resources.Fonts"
             xmlns:controls="clr-namespace:mau.Controls"
             xmlns:utils="clr-namespace:mau.Utils"
             x:Class="mau.ServiceListPage"
             x:DataType="viewmodel:ServicesViewModel"
             BackgroundColor="{DynamicResource Background}"
             Shell.NavBarIsVisible="False"
             Title="Сервисы">
    <Grid Padding="{x:Static utils:LayoutMetrics.PagePadding}"
          MaximumWidthRequest="{x:Static utils:LayoutMetrics.MaxContentWidth}">
        <CollectionView ItemsSource="{Binding ServiceRows}"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="7" Margin="0,0,0,14">
                    <Label Text="Сервисы" Style="{StaticResource PageTitle}" FontSize="28" />
                    <Label Text="{Binding PageDescription}" Style="{StaticResource SectionSubtitle}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:ServiceRow">
                    <VerticalStackLayout Spacing="{x:Static utils:LayoutMetrics.SectionHeaderSpacing}"
                                         Margin="0,0,0,{x:Static utils:LayoutMetrics.SectionStackSpacing}">
                        <Label Text="{Binding SectionTitle}"
                               IsVisible="{Binding HasSectionTitle}"
                               Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="{x:Static utils:LayoutMetrics.GridGutter}">
                            <Border Grid.Column="0"
                                    controls:LiquidGlass.UsesLiquidGlass="True"
                                    MinimumHeightRequest="{x:Static utils:LayoutMetrics.ServiceCardMinHeight}"
                                    Padding="{x:Static utils:LayoutMetrics.ServiceCardPaddingThickness}"
                                    BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource BorderSubtle}"
                                    StrokeThickness="1"
                                    SemanticProperties.Description="{Binding Left.ServiceName}"
                                    SemanticProperties.Hint="Открыть сервис">
                                <Grid RowDefinitions="auto,*" RowSpacing="12">
                                    <Border WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            BackgroundColor="{DynamicResource PrimaryLight}"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Left.Glyph}"
                                               FontFamily="FluentUI"
                                               FontSize="22"
                                               TextColor="{DynamicResource Primary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,auto">
                                        <VerticalStackLayout Spacing="4" VerticalOptions="End">
                                            <Label Text="{Binding Left.ServiceName}"
                                                   FontFamily="MontserratSemiBold"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   MaxLines="2"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Left.Subtitle}"
                                                   Style="{StaticResource SectionSubtitle}"
                                                   FontSize="11"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{x:Static fonts:FluentUI.arrow_up_right_20_regular}"
                                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                               FontSize="14"
                                               TextColor="{DynamicResource TextMuted}"
                                               VerticalOptions="End" />
                                    </Grid>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=SelectService, Source={RelativeSource AncestorType={x:Type viewmodel:ServicesViewModel}}, x:DataType={x:Type viewmodel:ServicesViewModel}}"
                                                          CommandParameter="{Binding Left.ServicePage}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Grid.Column="1"
                                    controls:LiquidGlass.UsesLiquidGlass="True"
                                    MinimumHeightRequest="{x:Static utils:LayoutMetrics.ServiceCardMinHeight}"
                                    Padding="{x:Static utils:LayoutMetrics.ServiceCardPaddingThickness}"
                                    BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource BorderSubtle}"
                                    StrokeThickness="1"
                                    SemanticProperties.Description="{Binding Right.ServiceName}"
                                    SemanticProperties.Hint="Открыть сервис">
                                <Grid RowDefinitions="auto,*" RowSpacing="12">
                                    <Border WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            BackgroundColor="{DynamicResource PrimaryLight}"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Right.Glyph}"
                                               FontFamily="FluentUI"
                                               FontSize="22"
                                               TextColor="{DynamicResource Primary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,auto">
                                        <VerticalStackLayout Spacing="4" VerticalOptions="End">
                                            <Label Text="{Binding Right.ServiceName}"
                                                   FontFamily="MontserratSemiBold"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   MaxLines="2"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Right.Subtitle}"
                                                   Style="{StaticResource SectionSubtitle}"
                                                   FontSize="11"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{x:Static fonts:FluentUI.arrow_up_right_20_regular}"
                                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                               FontSize="14"
                                               TextColor="{DynamicResource TextMuted}"
                                               VerticalOptions="End" />
                                    </Grid>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=SelectService, Source={RelativeSource AncestorType={x:Type viewmodel:ServicesViewModel}}, x:DataType={x:Type viewmodel:ServicesViewModel}}"
                                                          CommandParameter="{Binding Right.ServicePage}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
