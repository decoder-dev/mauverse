<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="PageRoot"
             xmlns:viewmodel="clr-namespace:mau.ViewModel"
             xmlns:fonts="clr-namespace:mau.Resources.Fonts"
             xmlns:utils="clr-namespace:mau.Utils"
             x:Class="mau.ProfilePage"
             Title="Профиль"
             x:DataType="viewmodel:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="{DynamicResource Background}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding Source={x:Reference PageRoot}, Path=BindingContext, x:DataType={x:Type ContentPage}}"
                                        Command="{Binding LoadData}"
                                        EventName="Appearing" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding Source={x:Reference PageRoot}, Path=BindingContext, x:DataType={x:Type ContentPage}}"
                                        Command="{Binding CancelPendingOperationsCommand}"
                                        EventName="Disappearing" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Templates/SearchListTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="{x:Static utils:LayoutMetrics.PagePadding}"
                             Spacing="{x:Static utils:LayoutMetrics.SectionStackSpacing}"
                             MaximumWidthRequest="{x:Static utils:LayoutMetrics.MaxContentWidth}">
            <VerticalStackLayout Spacing="3">
                <Label Text="Профиль" Style="{StaticResource PageTitle}" />
                <Label Text="Учетная запись и учебные данные"
                       Style="{StaticResource SectionSubtitle}" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                <Border HeightRequest="56"
                        WidthRequest="56"
                        Padding="0"
                        BackgroundColor="{DynamicResource PrimaryLight}"
                        StrokeThickness="0">
                    <Label Text="{x:Static fonts:FluentUI.person_32_regular}"
                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                           FontSize="30"
                           TextColor="{DynamicResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding Name}"
                           FontFamily="MontserratBold"
                           FontSize="19"
                           TextColor="{DynamicResource TextPrimary}"
                           MaxLines="2"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Group}"
                           Style="{StaticResource SectionSubtitle}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource SurfacePanel}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Учебные данные" Style="{StaticResource SectionTitle}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding GroupLabel}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource EntryBorder}"
                                Margin="0"
                                IsEnabled="{Binding IsEdit}">
                            <Entry Text="{Binding Group}"
                                   IsEnabled="{Binding IsEdit}"
                                   Placeholder="Например, ИС-21">
                                <Entry.Behaviors>
                                    <toolkit:EventToCommandBehavior BindingContext="{Binding Source={x:Reference PageRoot}, Path=BindingContext, x:DataType={x:Type ContentPage}}"
                                                                    EventName="TextChanged"
                                                                    Command="{Binding GroupTextChangedCommand}"/>
                                </Entry.Behaviors>
                            </Entry>
                        </Border>
                        <Label Text="{Binding GroupHint}"
                               Style="{StaticResource SectionSubtitle}"
                               IsVisible="{Binding IsEdit}" />
                        <CollectionView IsVisible="{Binding IsGroupListVisible}"
                                        MaximumHeightRequest="220"
                                        ItemsSource="{Binding GroupList}"
                                        ItemTemplate="{StaticResource GroupListItemTemplate}" />
                    </VerticalStackLayout>

                    <Button Text="{Binding ButtonChangeLabel}"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="13"
                            HorizontalOptions="Start"
                            IsVisible="{Binding SubGroupButtonIsVisible}"
                            Command="{Binding Change}" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding DescriptionLabel}" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding GroupDescription}"
                               FontSize="15"
                               TextColor="{DynamicResource TextPrimary}"
                               LineHeight="1.3" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding IsCreditBookPanelIsVisible}">
                        <Label Text="{Binding CreditBookLabel}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource EntryBorder}"
                                Margin="0"
                                IsEnabled="{Binding IsEdit}">
                            <Entry Text="{Binding CreditBook}"
                                   IsEnabled="{Binding IsEdit}"
                                   Placeholder="Номер зачетной книжки" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Button Text="{Binding ButtonEditLabel}"
                        HorizontalOptions="Fill"
                        Command="{Binding Edit}" />
                <Border Style="{StaticResource SurfacePanel}"
                        Padding="{x:Static utils:LayoutMetrics.ServiceCardPaddingThickness}"
                        SemanticProperties.Description="Открыть настройки приложения">
                    <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="12">
                        <Label Text="{x:Static fonts:FluentUI.settings_24_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="23"
                               TextColor="{DynamicResource Primary}"
                               VerticalTextAlignment="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Настройки приложения"
                                   FontFamily="MontserratSemiBold"
                                   FontSize="15" />
                            <Label Text="Данные и сведения о приложении"
                                   Style="{StaticResource SectionSubtitle}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="20"
                               TextColor="{DynamicResource TextMuted}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSettings}" />
                    </Border.GestureRecognizers>
                </Border>
                <Button Text="{Binding ButtonExitLabel}"
                        Style="{StaticResource DangerButton}"
                        HorizontalOptions="Fill"
                        Command="{Binding Exit}" />
                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   SemanticProperties.Description="Сохранение профиля"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
