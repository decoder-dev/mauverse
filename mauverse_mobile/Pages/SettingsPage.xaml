<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="PageRoot"
             xmlns:viewmodel="clr-namespace:mau.ViewModel"
             xmlns:fonts="clr-namespace:mau.Resources.Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="mau.SettingsPage"
             x:DataType="viewmodel:SettingsViewModel"
             Title="Настройки"
             BackgroundColor="{DynamicResource Background}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding Source={x:Reference PageRoot}, Path=BindingContext, x:DataType={x:Type ContentPage}}"
                                        EventName="Appearing"
                                        Command="{Binding LoadSettingsCommand}" />
    </ContentPage.Behaviors>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="16,18,16,36"
                             Spacing="24"
                             MaximumWidthRequest="620">
            <VerticalStackLayout Spacing="10">
                <Label Text="Оформление" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SurfacePanel}" Padding="16">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="auto,*" ColumnSpacing="12">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource PrimaryLight}"
                                    StrokeThickness="0">
                                <Label Text="{x:Static fonts:FluentUI.dark_theme_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="23"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Тема приложения"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="15"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Системная, светлая или темная"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border Padding="3"
                                BackgroundColor="{DynamicResource SurfaceMuted}"
                                Stroke="{DynamicResource BorderSubtle}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                                <Button Grid.Column="0"
                                        Text="Системная"
                                        Command="{Binding SelectThemeCommand}"
                                        CommandParameter="System"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextSecondary}"
                                        FontFamily="MontserratSemiBold"
                                        FontSize="12"
                                        CornerRadius="6"
                                        Padding="5,8"
                                        MinimumHeightRequest="52"
                                        LineBreakMode="WordWrap"
                                        HorizontalOptions="Fill"
                                        SemanticProperties.Description="Системная тема"
                                        SemanticProperties.Hint="Использовать тему устройства">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsSystemThemeSelected}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryAccent}" />
                                            <Setter Property="TextColor" Value="{DynamicResource PrimaryAccentText}" />
                                            <Setter Property="SemanticProperties.Description" Value="Системная тема, выбрана" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="1"
                                        Text="Светлая"
                                        Command="{Binding SelectThemeCommand}"
                                        CommandParameter="Light"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextSecondary}"
                                        FontFamily="MontserratSemiBold"
                                        FontSize="12"
                                        CornerRadius="6"
                                        Padding="5,8"
                                        MinimumHeightRequest="52"
                                        LineBreakMode="WordWrap"
                                        HorizontalOptions="Fill"
                                        SemanticProperties.Description="Светлая тема"
                                        SemanticProperties.Hint="Включить светлую тему">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsLightThemeSelected}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryAccent}" />
                                            <Setter Property="TextColor" Value="{DynamicResource PrimaryAccentText}" />
                                            <Setter Property="SemanticProperties.Description" Value="Светлая тема, выбрана" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="2"
                                        Text="Темная"
                                        Command="{Binding SelectThemeCommand}"
                                        CommandParameter="Dark"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextSecondary}"
                                        FontFamily="MontserratSemiBold"
                                        FontSize="12"
                                        CornerRadius="6"
                                        Padding="5,8"
                                        MinimumHeightRequest="52"
                                        LineBreakMode="WordWrap"
                                        HorizontalOptions="Fill"
                                        SemanticProperties.Description="Темная тема"
                                        SemanticProperties.Hint="Включить темную тему">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsDarkThemeSelected}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryAccent}" />
                                            <Setter Property="TextColor" Value="{DynamicResource PrimaryAccentText}" />
                                            <Setter Property="SemanticProperties.Description" Value="Темная тема, выбрана" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Данные" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SurfacePanel}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16"
                              ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource PrimaryLight}"
                                    StrokeThickness="0">
                                <Label Text="{x:Static fonts:FluentUI.storage_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="23"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Временные данные"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="15"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding CacheStatusLabel}"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <ActivityIndicator Grid.Column="2"
                                               IsVisible="{Binding IsCacheBusy}"
                                               IsRunning="{Binding IsCacheBusy}"
                                               SemanticProperties.Description="Обработка временных данных"
                                               HeightRequest="24"
                                               WidthRequest="24"
                                               VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="16,0"
                                 BackgroundColor="{DynamicResource BorderSubtle}" />

                        <Grid Padding="16,13"
                              ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="64"
                              SemanticProperties.Description="Очистить кэш новостей, контактов и справочников"
                              SemanticProperties.Hint="Удаляет только временные данные">
                            <Label Text="{x:Static fonts:FluentUI.broom_24_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   WidthRequest="44" />
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="Очистить кэш"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Новости, контакты и справочники"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearContentCacheCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Система" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SurfacePanel}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,14"
                              ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="72"
                              SemanticProperties.Description="Открыть разрешения и уведомления MAUverse"
                              SemanticProperties.Hint="Откроет системные настройки Android">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    StrokeThickness="0">
                                <Label Text="{x:Static fonts:FluentUI.settings_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="22"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Настройки устройства"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Разрешения и уведомления"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:FluentUI.open_24_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSystemSettingsCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="72,0,16,0"
                                 BackgroundColor="{DynamicResource BorderSubtle}" />

                        <Grid Padding="16,14"
                              ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="72"
                              SemanticProperties.Description="Скопировать технические сведения о приложении"
                              SemanticProperties.Hint="Скопирует безопасную диагностику в буфер обмена">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    StrokeThickness="0">
                                <Label Text="{x:Static fonts:FluentUI.clipboard_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="22"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Скопировать диагностику"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Версия, устройство и адрес API"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:FluentUI.copy_24_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CopyDiagnosticsCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Университет" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SurfacePanel}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,14"
                              ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="72"
                              SemanticProperties.Description="Открыть официальный сайт МАУ"
                              SemanticProperties.Hint="Откроет mauniver.ru">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    StrokeThickness="0">
                                <Label Text="{x:Static fonts:FluentUI.globe_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="22"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Официальный сайт"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="mauniver.ru"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:FluentUI.open_24_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenUniversityLinkCommand}"
                                                      CommandParameter="official-site" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="72,0,16,0"
                                 BackgroundColor="{DynamicResource BorderSubtle}" />

                        <Grid Padding="16,14"
                              ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="72"
                              SemanticProperties.Description="Политика персональных данных МАУ"
                              SemanticProperties.Hint="Откроет раздел о персональных данных">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    StrokeThickness="0">
                                <Label Text="{x:Static fonts:FluentUI.shield_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="22"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Политика персональных данных"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Документы об обработке ПДн"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:FluentUI.open_24_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenUniversityLinkCommand}"
                                                      CommandParameter="privacy-policy" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="72,0,16,0"
                                 BackgroundColor="{DynamicResource BorderSubtle}" />

                        <Grid Padding="16,14"
                              ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="72"
                              SemanticProperties.Description="Сведения об образовательной организации"
                              SemanticProperties.Hint="Откроет раздел sveden на сайте МАУ">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    StrokeThickness="0">
                                <Label Text="{x:Static fonts:FluentUI.document_one_page_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="22"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Сведения об организации"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Обязательная информация вуза"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{x:Static fonts:FluentUI.open_24_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenUniversityLinkCommand}"
                                                      CommandParameter="sveden" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="О приложении" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SurfacePanel}" Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="auto,*" ColumnSpacing="14">
                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource PrimaryAccent}"
                                    StrokeThickness="0">
                                <Label Text="C"
                                       FontFamily="MontserratBold"
                                       FontSize="22"
                                       TextColor="{DynamicResource PrimaryAccentText}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding AppNameLabel}"
                                       FontFamily="MontserratBold"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding AppVersionLabel}"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{DynamicResource BorderSubtle}" />

                        <Grid ColumnDefinitions="*,auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding AppCreditsLabel}"
                                       FontFamily="MontserratMedium"
                                       FontSize="13"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Мурманский арктический университет"
                                       Style="{StaticResource SectionSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding PlatformLabel}"
                                   FontFamily="MontserratMedium"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSecondary}"
                                   MaximumWidthRequest="120"
                                   HorizontalTextAlignment="End"
                                   LineBreakMode="WordWrap"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
