<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:viewmodel="clr-namespace:mau.ViewModel.Dialogs"
               xmlns:controls="clr-namespace:mau.Controls"
               x:Class="mau.Dialogs.DetailNewsPopup"
               x:DataType="viewmodel:DetailsNewsViewModel"
               BackgroundColor="Transparent">
    <Border controls:LiquidGlass.UsesLiquidGlass="True"
            BackgroundColor="{DynamicResource Surface}"
            Stroke="{DynamicResource BorderSubtle}"
            StrokeThickness="1"
            Padding="16">
        <Grid RowDefinitions="auto, 2*, 3*, auto" RowSpacing="12">
            <Label Text="{Binding Title}"
                   VerticalOptions="Start"
                   LineHeight="1.2"
                   FontFamily="MontserratBold"
                   FontSize="18"
                   MaxLines="3"
                   LineBreakMode="TailTruncation"/>
            <Border Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                   Padding="0">
                <Image Source="{Binding ImageUrl}"
                       AutomationProperties.IsInAccessibleTree="False"
                       Aspect="AspectFill"/>
            </Border>
            <ScrollView Grid.Row="2">
                <Label Text="{Binding Description}"
                       LineHeight="1.25"
                       FontSize="13"/>
            </ScrollView>
            <Grid Grid.Row="3" ColumnDefinitions="*, auto" ColumnSpacing="8">
                <Label Text="{Binding Publish}"
                       FontSize="12"
                       TextColor="{DynamicResource TextSecondary}"
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        HorizontalOptions="End"
                        Text="Открыть статью"
                        Command="{Binding GoToFull}"
                        CommandParameter="{Binding Url}"
                        FontSize="12"/>
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
