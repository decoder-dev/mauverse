<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Official MAU brand colors and accessible semantic aliases. -->
    <Color x:Key="BrandBlue">#008CFA</Color>
    <Color x:Key="BrandBlueClassic">#0064BE</Color>
    <Color x:Key="BrandBlueDark">#005AE0</Color>
    <Color x:Key="BrandBluePale">#F6FAFE</Color>
    <Color x:Key="BrandRed">#F9423A</Color>
    <Color x:Key="BrandRedDark">#D31107</Color>
    <Color x:Key="BrandRedPale">#FCF0F0</Color>
    <Color x:Key="BrandTeal">#14898F</Color>

    <Color x:Key="Primary">#005AE0</Color>
    <Color x:Key="PrimaryAccent">#008CFA</Color>
    <Color x:Key="PrimaryAccentText">#1E1E1E</Color>
    <Color x:Key="PrimaryDark">#005AE0</Color>
    <Color x:Key="PrimaryLight">#F6FAFE</Color>
    <Color x:Key="PrimaryDarkText">#1E1E1E</Color>
    <Color x:Key="Secondary">#0064BE</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#14898F</Color>
    <Color x:Key="Background">#F6FAFE</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#F1F5F9</Color>
    <Color x:Key="BorderSubtle">#E2E8F0</Color>
    <Color x:Key="TextPrimary">#1E1E1E</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="Success">#0E7378</Color>
    <Color x:Key="SuccessDarkForeground">#2AA7AE</Color>
    <Color x:Key="SuccessLight">#E8F7F7</Color>
    <Color x:Key="Info">#005AE0</Color>
    <Color x:Key="Warning">#9A4D00</Color>
    <Color x:Key="WarningDarkForeground">#FFB45C</Color>
    <Color x:Key="WarningLight">#FFF4E5</Color>
    <Color x:Key="Error">#D31107</Color>
    <Color x:Key="ErrorLight">#FCF0F0</Color>
    <Color x:Key="Disable">#E2E8F0</Color>
    <Color x:Key="PrimaryPanelBackground">#005AE0</Color>
    <Color x:Key="PrimaryPanelMuted">#D8EAFF</Color>
    <Color x:Key="ErrorDarkForeground">#F9423A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1E1E1E</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CCCCCC</Color>
    <Color x:Key="Gray400">#999999</Color>
    <Color x:Key="Gray500">#666666</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#222222</Color>
    <Color x:Key="Gray950">#111111</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{DynamicResource PrimaryAccent}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLight}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource Surface}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtle}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
