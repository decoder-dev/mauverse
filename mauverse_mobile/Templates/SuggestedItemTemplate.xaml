<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fonts="clr-namespace:mau.Resources.Fonts"
             x:Class="mau.Templates.SuggestedItemTemplate">
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="SuggestedContainerStyle" TargetType="Grid">
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="WidthRequest" Value="52" />
                <Setter Property="Margin" Value="0, 0, 12, 0" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid
            Style="{StaticResource SuggestedContainerStyle}">
            <Border BackgroundColor="{DynamicResource PrimaryLight}"
                    StrokeThickness="0"
                    Padding="0">
                <Label Text="{x:Static fonts:FluentUI.person_24_regular}"
                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                       FontSize="24"
                       TextColor="{DynamicResource Primary}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </Grid>
    </ContentView.Content>
</ContentView>
