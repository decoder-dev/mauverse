<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:mau.Controls"
             xmlns:viewmodel="clr-namespace:mau.ViewModel.Services"
             x:Class="mau.Templates.SearchListTemplate">
    <DataTemplate x:Key="TeacherListItemTemplate" x:DataType="x:String">
        <Border Margin="0,0,0,4"
                controls:LiquidGlass.UsesLiquidGlass="True"
                Padding="12,8"
                MinimumHeightRequest="48"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource BorderSubtle}"
                StrokeThickness="1"
                SemanticProperties.Description="{Binding .}"
                SemanticProperties.Hint="Выбрать преподавателя">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Path=TeacherSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:InfoViewModel}}, x:DataType={x:Type viewmodel:InfoViewModel}}"
                                      CommandParameter="{Binding .}">

                </TapGestureRecognizer>
            </Border.GestureRecognizers>
            <Label VerticalOptions="Center" Text="{Binding .}" Style="{StaticResource ListLabel}"/>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="ListItemTemplate" x:DataType="x:String">
        <ViewCell>
            <Grid Padding="12,8" MinimumHeightRequest="48" BackgroundColor="{DynamicResource Surface}">
                <Label VerticalOptions="Center" Text="{Binding .}" Style="{StaticResource ListLabel}"/>
            </Grid>
        </ViewCell>
    </DataTemplate>
</ResourceDictionary>
