<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mau.Templates.RecentChatTemplate"
             xmlns:viewmodel="clr-namespace:mau.ViewModel"
             xmlns:dto="clr-namespace:mau.DTOModels"
             xmlns:fonts="clr-namespace:mau.Resources.Fonts"
             x:DataType="dto:RecentChatsDTO">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="RecentImageContainerStyle" TargetType="Grid">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HeightRequest" Value="72" />
                <Setter Property="WidthRequest" Value="72" />
            </Style>

            <Style x:Key="RecentImageStyle" TargetType="Image">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Margin" Value="10" />
            </Style>

            <Style x:Key="NameTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="12, 0" />
            </Style>

            <Style x:Key="MessageTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="1" />
                <Setter Property="Margin" Value="12, 12, 12, 0" />
            </Style>

            <Style x:Key="TimeTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid
          ColumnDefinitions="Auto, *"
          RowSpacing="0"
          Margin="12, 24"
          SemanticProperties.Description="{Binding User.FullName}"
          SemanticProperties.Hint="Открыть диалог">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer                
                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MainChatViewModel}}, Path=ChatSelected, x:DataType={x:Type viewmodel:MainChatViewModel}}"
                    CommandParameter="{Binding User}"/>
            </Grid.GestureRecognizers>
            <Grid
                Style="{StaticResource RecentImageContainerStyle}">
                <Border WidthRequest="48"
                        HeightRequest="48"
                        Padding="0"
                        BackgroundColor="{DynamicResource PrimaryLight}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Label Text="{x:Static fonts:FluentUI.person_24_regular}"
                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                           FontSize="24"
                           TextColor="{DynamicResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
            </Grid>
            <Grid
            Grid.Column="1"   
            ColumnDefinitions="*, Auto">
                <StackLayout>
                    <Label        
                        Text="{Binding User.FullName}"
                        Style="{StaticResource NameTextStyle}"/>
                    <Label         
                        Text="{Binding Message.Text}"
                        Style="{StaticResource MessageTextStyle}"/>
                </StackLayout>
                <Label 
                    Grid.Column="1"
                    Text="{Binding Message.TimeCreateString}"
                    Style="{StaticResource TimeTextStyle}"/>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>
