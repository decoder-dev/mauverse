# Required database settings. Keep real credentials outside source control.
SCHEDULE_DB_HOST=
SCHEDULE_DB_PORT=3306
SCHEDULE_DB_NAME=1c
SCHEDULE_DB_USER=
SCHEDULE_DB_PASSWORD=

DEBT_DB_HOST=
DEBT_DB_PORT=3306
DEBT_DB_NAME=lko
DEBT_DB_USER=
DEBT_DB_PASSWORD=

# Database resilience.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=15
DB_WRITE_TIMEOUT_SECONDS=15
DB_CONNECT_ATTEMPTS=2

# Student form delivery.
MAIL_ADDRESS=mauverse@mauniver.ru
MAIL_COPY_ADDRESS=
MAIL_API_BASE_URL=https://api.mauniver.ru
MAIL_API_URL=/send-email

# Approved external origins.
MAIN_URL=https://www.mauniver.ru
EIOS_AUTH_URL=https://eios.mauniver.ru/moodle/webservice/rest/server.php

# Authentication cache limits.
AUTH_CACHE_TTL_SECONDS=60
AUTH_CACHE_MAX_ENTRIES=512
AUTH_IP_RATE_LIMIT_REQUESTS=20
AUTH_USERNAME_RATE_LIMIT_REQUESTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
FORM_RATE_LIMIT_REQUESTS=3
FORM_RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ENTRIES=4096

# Shared outbound HTTP transport.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_POOL_SIZE=20

# Runtime behavior. API documentation is disabled by default.
ENVIRONMENT=production
ENABLE_DOCS=false
